{
  "name": "dsh-phone-link",
  "version": "0.4.1",
  "description": "Phone <-> DSH session bridge: a right-sidebar tab that connects your Feishu chat to a live DSH conversation.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "jieye666",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "feishu",
    "lark",
    "phone",
    "remote"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jieye666/dsh-phone-link.git"
  },
  "homepage": "https://github.com/jieye666/dsh-phone-link#readme",
  "bugs": {
    "url": "https://github.com/jieye666/dsh-phone-link/issues"
  }
}
